# Copy this file to .env and fill in real values.
# See README.md for what each variable is used for.

# --- Client-side (read at build time via import.meta.env) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side (for `vercel dev` locally; set these in the Vercel
#     project's environment variables for production, not just here) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EARLY_PARTNER=
STRIPE_PRICE_GROWTH_PARTNER=
STRIPE_PRICE_MARKET_LEADER=
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
